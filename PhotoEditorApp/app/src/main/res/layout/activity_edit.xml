<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/bg_toolbar">

        <Button
            android:id="@+id/btnCancel"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <Button
            android:id="@+id/btnReset"
            android:text="Reset"
            android:textColor="#AAAAAA"
            android:backgroundTint="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <Button
            android:id="@+id/btnSave"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>
    </LinearLayout>

    <!-- Photo preview + loading overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:minHeight="150dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Bottom tool icons -->
    <LinearLayout
        android:id="@+id/bottomTools"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_toolbar">

        <!-- Adjust -->
        <LinearLayout android:id="@+id/toolAdjust"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:src="@drawable/ic_adjust"
                android:layout_width="24dp" android:layout_height="24dp"
                android:id="@+id/iconAdjust"/>
            <TextView android:text="Adjust" android:textSize="10sp"
                android:textColor="@color/text_secondary" android:id="@+id/labelAdjust"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- Filters -->
        <LinearLayout android:id="@+id/toolFilters"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:src="@drawable/ic_filter"
                android:layout_width="24dp" android:layout_height="24dp"
                android:id="@+id/iconFilters"/>
            <TextView android:text="Filters" android:textSize="10sp"
                android:textColor="@color/text_secondary" android:id="@+id/labelFilters"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- Crop -->
        <LinearLayout android:id="@+id/toolCrop"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:src="@drawable/ic_crop"
                android:layout_width="24dp" android:layout_height="24dp"/>
            <TextView android:text="Crop" android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- Auto -->
        <LinearLayout android:id="@+id/toolAuto"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:src="@drawable/ic_auto"
                android:layout_width="24dp" android:layout_height="24dp"/>
            <TextView android:text="Auto" android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- Portrait -->
        <LinearLayout android:id="@+id/toolPortrait"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:src="@drawable/ic_portrait"
                android:layout_width="24dp" android:layout_height="24dp"/>
            <TextView android:text="Portrait" android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- Markup -->
        <LinearLayout android:id="@+id/toolMarkup"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:clickable="true" android:focusable="true">
            <ImageView android:src="@drawable/ic_markup"
                android:layout_width="24dp" android:layout_height="24dp"
                android:id="@+id/iconMarkup"/>
            <TextView android:text="Markup" android:textSize="10sp"
                android:textColor="@color/text_secondary" android:id="@+id/labelMarkup"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ====== ADJUSTMENT PANEL ====== -->
    <LinearLayout
        android:id="@+id/panelAdjustments"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:orientation="vertical"
        android:background="@color/bg_panel"
        android:visibility="gone">

        <!-- Category tabs -->
        <LinearLayout
            android:id="@+id/categoryTabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@color/bg_toolbar">

            <TextView android:id="@+id/tabLight"
                android:text="Light" android:textSize="13sp"
                android:textColor="@color/tab_inactive" android:gravity="center"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/tabColor"
                android:text="Color" android:textSize="13sp"
                android:textColor="@color/tab_inactive" android:gravity="center"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/tabBW"
                android:text="B&amp;W" android:textSize="13sp"
                android:textColor="@color/tab_inactive" android:gravity="center"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/tabDetail"
                android:text="Detail" android:textSize="13sp"
                android:textColor="@color/tab_inactive" android:gravity="center"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:clickable="true" android:focusable="true"/>
        </LinearLayout>

        <!-- Active tab indicator -->
        <View
            android:id="@+id/tabIndicator"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="@color/accent"/>

        <!-- Sliders -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/slidersContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- ====== FILTERS PANEL ====== -->
    <LinearLayout
        android:id="@+id/panelFilters"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:orientation="vertical"
        android:background="@color/bg_panel"
        android:visibility="gone">

        <!-- Intensity row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:text="Intensity"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"/>
            <SeekBar
                android:id="@+id/seekFilterIntensity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"/>
        </LinearLayout>

        <!-- Filter thumbnails -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <LinearLayout
                android:id="@+id/filtersRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
