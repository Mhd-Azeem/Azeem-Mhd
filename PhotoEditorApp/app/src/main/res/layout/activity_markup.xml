<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#2a2a2a">
        <Button
            android:id="@+id/btnMarkupCancel"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <TextView
            android:text="Markup"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <Button
            android:id="@+id/btnMarkupDone"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0A84FF"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>
    </LinearLayout>

    <!-- Drawing canvas (markup view over image) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">
        <ImageView
            android:id="@+id/markupImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"/>
        <com.photoeditor.app.view.MarkupView
            android:id="@+id/markupView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>

    <!-- Tools row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#2a2a2a">
        <ImageButton
            android:id="@+id/btnPen"
            android:src="@drawable/ic_markup"
            android:contentDescription="Pen"
            android:backgroundTint="#0A84FF"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/btnHighlighter"
            android:text="Highlight"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/btnEraser"
            android:text="Eraser"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <Button
            android:id="@+id/btnMarkupUndo"
            android:text="↩ Undo"
            android:textColor="#FFFFFF"
            android:backgroundTint="#444444"
            android:layout_width="wrap_content"
            android:layout_height="40dp"/>
    </LinearLayout>

    <!-- Color palette -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#1a1a1a"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:id="@+id/colorPalette"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- Stroke size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="#1a1a1a">
        <TextView
            android:text="Size"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_width="40dp"
            android:layout_height="wrap_content"/>
        <SeekBar
            android:id="@+id/seekMarkupSize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="50"
            android:progress="5"/>
    </LinearLayout>

</LinearLayout>
